// File name: projects/1/Xor.hdl
/**
 * Exclusive-or gate:
 * if ((a and Not(b)) or (Not(a) and b)) out = 1, else out = 0
 */
CHIP Xor {
    IN a, b;
    OUT out;

    PARTS:
    // Condition1: A is true and b is false
    Not(in=b, out=notb);
    And(a=a, b=notb, out=cond1);

    // Condition2: B is true and A is false
    Not(in=a, out=nota);
    And(a=nota, b=b, out=cond2);

    Or(a=cond1, b=cond2, out=out);
}
